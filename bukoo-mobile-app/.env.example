# ─── BUKOO Environment Variables ─────────────────────────────────────────────
# Copy this file to .env (for API) and fill in the values.
# Never commit .env files with real secrets to version control.
#
# Required:  value must be set before the app will start.
# Optional:  has a reasonable default; override when needed.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | production | test
PORT=3000                             # [Optional] HTTP port (default: 3000)

# ── Database — Supabase / PostgreSQL ─────────────────────────────────────────
# Pooled connection via PgBouncer (used by the app at runtime)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection (bypasses PgBouncer; required by Prisma Migrate)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Redis — Upstash ───────────────────────────────────────────────────────────
# rediss:// (TLS) for Upstash; redis:// for local
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Social Auth — Google ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                     # Web OAuth 2.0 Client ID from Google Cloud Console

# ── Social Auth — Apple ───────────────────────────────────────────────────────
APPLE_TEAM_ID=                        # 10-char Team ID from developer.apple.com
APPLE_KEY_ID=                         # Key ID of the Sign in with Apple private key
APPLE_PRIVATE_KEY=                    # Contents of the .p8 private key file (newlines → \n)

# ── Payment — Midtrans ────────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=                  # Starts with SB- (sandbox) or production key
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false          # Set to true in production

# ── Payment — Xendit ─────────────────────────────────────────────────────────
XENDIT_SECRET_KEY=                    # xnd_production_... or xnd_development_...

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=                    # Safe to expose in frontend (RLS enforced)
SUPABASE_SERVICE_ROLE_KEY=            # Keep secret — bypasses RLS

# ── Mobile (apps/mobile/.env) ────────────────────────────────────────────────
# Used by the React Native app at build/runtime via process.env
API_URL=https://your-api.railway.app/v1
