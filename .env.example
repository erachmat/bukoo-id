# Web app runs on Cloudflare Workers — the database is D1 (via the `DB`
# binding), not a Postgres connection string. No DATABASE_URL needed for the
# web app (legacy Neon var removed 2026-08-16).

# Auth (NextAuth)
# Generate a secret: npx auth secret
AUTH_SECRET="your-super-secret-key-at-least-32-chars"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Transactional email (MailChannels Email API — optional)
# Used by the web password-reset OTP flow (2026-08-29). When unset, the OTP
# code is still generated and stored (the flow shows the same generic success)
# but the email is not delivered. Set on the deployed workers via
# `wrangler secret put MAILCHANNELS_API_KEY` / `MAIL_FROM`.
# Get a key: https://dash.mailchannels.com/account/api-keys
# MAILCHANNELS_API_KEY=""
# MAIL_FROM="noreply@bukoo.id"
