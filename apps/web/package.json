{
  "name": "bukoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build --prefix=../.. --workspace=@bukoo/shared-types && npm run build --prefix=../.. --workspace=@bukoo/db && next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "deploy:preview": "opennextjs-cloudflare build && wrangler deploy --name bukoo-web-preview",
    "deploy:prod": "NEXT_PUBLIC_SITE_URL=https://bukoo.id opennextjs-cloudflare build && wrangler deploy -c wrangler.prod.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@bukoo/db": "*",
    "@bukoo/shared-types": "*",
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.4.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.24.3"
  }
}
