# Copy this file to keystore.properties and fill in your release keystore values.
# keystore.properties is gitignored — NEVER commit real values.
#
# One-time setup (run from apps/mobile/android/app/ so the keystore lands where
# Gradle expects it — storeFile is resolved relative to the `app` module dir):
#   1. Generate a keystore (you choose the passwords, type them in your terminal):
#      ⚠️ If a password contains ! (e.g. Foo!bar), single-quote it on the command
#         line (or run keytool WITHOUT -storepass/-keypass and type it at the
#         prompt) — otherwise bash history-expands `!` and stores a mangled
#         password that won't match this file.
#      keytool -genkeypair -v -keystore bukoo-release.keystore \
#        -alias bukoo -keyalg RSA -keysize 2048 -validity 10000 \
#        -storepass 'YOUR_STORE_PASSWORD' -keypass 'YOUR_KEY_PASSWORD' \
#        -dname "CN=BUKOO, OU=Mobile, O=BUKOO, L=Jakarta, S=Jakarta, C=ID"
#   2. Create this file with the same values you used above.
#   3. BACK UP bukoo-release.keystore and these passwords — if lost, you cannot
#      update an app already installed with this key.
#
# storeFile is resolved relative to apps/mobile/android/app/ (the `app` module).

storeFile=bukoo-release.keystore
storePassword=CHANGE_ME
keyAlias=bukoo
keyPassword=CHANGE_ME
