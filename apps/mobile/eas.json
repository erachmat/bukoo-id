{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug"
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://bukoo-api.erachmat-dev.workers.dev/v1",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "17547501035-nolk1h8p5qlj7eujr2b9clec2omcvtv7.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://bukoo-api.erachmat-dev.workers.dev/v1",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "17547501035-nolk1h8p5qlj7eujr2b9clec2omcvtv7.apps.googleusercontent.com"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://bukoo-api.erachmat-dev.workers.dev/v1",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "17547501035-nolk1h8p5qlj7eujr2b9clec2omcvtv7.apps.googleusercontent.com"
      }
    }
  }
