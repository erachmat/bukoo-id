{
  "name": "@bukoo/db",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.js"
    },
    "./reading-manifest": {
      "types": "./dist/reading-manifest.d.ts",
      "import": "./dist/reading-manifest.js",
      "require": "./dist/reading-manifest.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:seed:demo": "tsx src/seed-demo-publisher.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "drizzle-orm": "^0.44.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/node": "^22.20.1",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5"
  }
}
